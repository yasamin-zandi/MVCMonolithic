@model MvcMonolithic.ApplicationService.Dtos.EditProductDto

@{
    ViewData["Title"] = "ویرایش محصول";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card custom-card border-0 shadow-sm rounded-4 overflow-hidden">
            <!-- هدر کارت -->
            <div class="card-header bg-white border-bottom border-light-subtle pt-4 px-4 pb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-4">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 mb-1 font-monospace">
                                ویرایش ردیف #@Model.Id
                            </span>
                            <h4 class="fw-bold mb-0 text-dark">ویرایش اطلاعات کالا</h4>
                        </div>
                    </div>
                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                        <i class="bi bi-shield-check me-1"></i> فرم معتبر
                    </span>
                </div>
            </div>

            <!-- بدنه فرم -->
            <div class="card-body px-4 py-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- عنوان کالا -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-tag-fill text-primary me-1"></i> عنوان محصول
                        </label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3 fs-6" placeholder="مثال: لپ‌تاپ ایسوس" />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3">
                        <!-- تعداد موجودی -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Count" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-layers-fill text-warning me-1"></i> تعداد موجودی
                            </label>
                            <input asp-for="Count" type="number" class="form-control form-control-lg rounded-3 fs-6 font-monospace" placeholder="0" />
                            <span asp-validation-for="Count" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- انتخاب دسته‌بندی -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-grid-fill text-info me-1"></i> دسته‌بندی
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select form-select-lg rounded-3 fs-6">
                                <option value="">-- انتخاب دسته‌بندی --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- فوتر دکمه‌ها -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light-subtle mt-3">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 text-secondary">
                            <i class="bi bi-arrow-right me-1"></i> بازگشت به لیست
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
