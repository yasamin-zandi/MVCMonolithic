@model MvcMonolithic.ApplicationService.Dtos.PostProductDto

@{
    ViewData["Title"] = "ایجاد محصول جدید";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card custom-card">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0">افزودن محصول جدید</h4>
                <p class="text-muted small">مشخصات اولیه کالا را با دقت وارد فرمایید.</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">عنوان محصول</label>
                        <input asp-for="Title" class="form-control rounded-3 py-2" placeholder="مثال: لپ‌تاپ ایسوس" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Count" class="form-label fw-semibold">تعداد</label>
                            <input asp-for="Count" class="form-control rounded-3 py-2" placeholder="0" />
                            <span asp-validation-for="Count" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">دسته‌بندی</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select rounded-3 py-2">
                                <option value="">انتخاب دسته‌بندی...</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">انصراف</a>
                        <button type="submit" class="btn btn-modern-primary px-4">ثبت نهایی</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
